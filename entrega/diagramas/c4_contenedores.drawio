<mxfile host="app.diagrams.net">
  <diagram id="c4-contenedores" name="C4 Contenedores">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="C4 Nivel 2 - Contenedores de TalkLate" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cliente" value="&lt;b&gt;Cliente Traductor&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Usa la app en su celular." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="interlocutor" value="&lt;b&gt;Interlocutor&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Responde con el celular del Cliente Traductor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Catalogo de idiomas y reportes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="limite" value="Sistema TalkLate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#444444;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="600" height="720" as="geometry" />
        </mxCell>
        <mxCell id="app" value="&lt;b&gt;App movil&lt;/b&gt;&lt;br&gt;[Contenedor: Expo / React Native]&lt;br&gt;iOS, Android y web. Burbuja de voz animada y modo chat; graba la voz (expo-audio)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API TalkLate&lt;/b&gt;&lt;br&gt;[Contenedor: Node.js 22 + Express, hexagonal]&lt;br&gt;Cuentas, conversaciones y mensajes, voz, catalogo, reportes.&lt;br&gt;Traduccion: Qwen -&gt; Claude -&gt; reglas (Circuit Breaker).&lt;br&gt;Voz: Whisper + prosodia; VoiceStudio -&gt; Azure -&gt; OpenAI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;fontSize=12;" vertex="340" parent="1">
          <mxGeometry x="340" y="330" width="320" height="190" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;[Contenedor: SurrealDB 3.x]&lt;br&gt;Usuarios, conversaciones, catalogo. Mensajes cifrados AES-256-GCM." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#3C7FC0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="590" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="voz" value="&lt;b&gt;Microfono y voz del dispositivo&lt;/b&gt;&lt;br&gt;[Sistema externo - en el cliente]&lt;br&gt;Grabacion (expo-audio) y voz de respaldo (expo-speech)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="90" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ollama" value="&lt;b&gt;Ollama + modelo Qwen&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;En el servidor de TalkLate. Motor principal." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1000" parent="1">
          <mxGeometry x="1000" y="240" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="claude" value="&lt;b&gt;API de Anthropic (Claude Sonnet)&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;Respaldo, solo si hay clave. Recibe solo el texto." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1000" parent="1">
          <mxGeometry x="1000" y="380" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="correo" value="&lt;b&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;Codigo de recuperacion (puerto Notificador)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1000" parent="1">
          <mxGeometry x="1000" y="940" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="Usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cliente" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Responde con el mismo celular" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="interlocutor" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Gestiona idiomas y reportes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="admin" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Graba y reproduce" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app" target="voz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="HTTPS/JSON REST /api/v1&lt;br&gt;(JWT acceso 15 min + token de refresco)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="Lee y escribe (HTTP /sql)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Traduce (HTTP local /api/chat)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="ollama">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Traduce si Qwen falla (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="claude">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="Envia codigo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="correo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="whisper" value="&lt;b&gt;Whisper&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;En el servidor de TalkLate (whisper.cpp). Voz a texto." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="vstudio" value="&lt;b&gt;VoiceStudio (IndexTTS 2)&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;En el servidor de TalkLate. Voz con emocion por vector." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="520" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="nube" value="&lt;b&gt;Azure Speech / OpenAI&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;Voz con emocion de respaldo, solo si hay clave. Recibe solo el texto traducido." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="660" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="Transcribe (HTTP local /v1/audio/transcriptions)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="whisper">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="Voz con emocion (HTTP local /generate)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="vstudio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="Voz si VoiceStudio falla (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="api" target="nube">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
