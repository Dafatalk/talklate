        <mxCell id="nube" value="&lt;b&gt;Azure Speech / OpenAI&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;Voz de respaldo, solo si hay clave." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="720" width="260" height="110" as="geometry" />
