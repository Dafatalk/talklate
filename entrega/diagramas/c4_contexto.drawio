        <mxCell id="e8" value="Transcribe el audio (HTTP local)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="talklate" target="whisper">
          <mxGeometry relative="1" as="geometry" />
