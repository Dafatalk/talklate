<mxfile host="app.diagrams.net">
  <diagram id="c4-contexto" name="C4 Contexto">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="C4 Nivel 1 - Contexto del sistema TalkLate" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cliente" value="&lt;b&gt;Cliente Traductor&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Dueno del celular. Usa la app para traducir conversaciones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="interlocutor" value="&lt;b&gt;Interlocutor&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;La otra persona. No instala la app; responde con el celular del Cliente Traductor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Gestiona el catalogo de idiomas y revisa reportes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#073B6F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="talklate" value="&lt;b&gt;TalkLate&lt;/b&gt;&lt;br&gt;[Sistema]&lt;br&gt;Traduccion en tiempo real con conciencia de matices culturales: contexto, emociones, jerga e intencion." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="300" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ollama" value="&lt;b&gt;Ollama + modelo Qwen&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;Corre en el servidor de TalkLate. Motor de traduccion principal." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="80" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="claude" value="&lt;b&gt;API de Anthropic (Claude Sonnet)&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;Respaldo. Solo si hay clave. Recibe solo el texto a traducir." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="240" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="correo" value="&lt;b&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;Codigo de recuperacion." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1000" parent="1">
          <mxGeometry x="1000" y="880" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="voz" value="&lt;b&gt;Microfono y voz del dispositivo&lt;/b&gt;&lt;br&gt;[Sistema externo - en el cliente]&lt;br&gt;Grabacion (expo-audio) y voz de respaldo (expo-speech)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1000" parent="1">
          <mxGeometry x="1000" y="1040" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="Habla o escribe y escucha traducciones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cliente" target="talklate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Responde usando el celular del Cliente Traductor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="interlocutor" target="talklate">
          <mxGeometry relative="1" as="geometry" />
