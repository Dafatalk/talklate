        <mxCell id="e7" value="Graba y reproduce" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="talklate" target="voz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="whisper" value="&lt;b&gt;Whisper&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;En el servidor de TalkLate. Voz a texto." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="400" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="vstudio" value="&lt;b&gt;VoiceStudio (IndexTTS 2)&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;En el servidor de TalkLate. Voz con emocion." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#6B6B6B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="560" width="260" height="110" as="geometry" />
