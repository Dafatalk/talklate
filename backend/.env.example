# Puerto del API
PORT=3000
# Secreto para firmar los tokens (cambiar en produccion)
JWT_SECRET=cambia-este-secreto
# Ruta de la base de datos SQLite (por defecto data/talklate.db)
# TALKLATE_DB=./data/talklate.db
# Admin inicial (se crea al arrancar si no existe)
ADMIN_CORREO=dafa123.daf@gmail.com
ADMIN_PASSWORD=Admin123!
# Motor de traduccion. "auto" prueba en orden: Qwen local (Ollama) -> Claude Sonnet (si hay clave) -> motor de reglas.
# Otras opciones: qwen, claude, local (solo reglas).
TRADUCTOR=auto
# Qwen local con Ollama (https://ollama.com): ollama pull qwen2.5:7b
# OLLAMA_URL=http://localhost:11434
# QWEN_MODEL=qwen2.5:7b
# QWEN_TIMEOUT_MS=60000
# Respaldo con Claude Sonnet
# ANTHROPIC_API_KEY=
# TALKLATE_MODEL=claude-sonnet-5-5
# Recuperacion de contrasena: "consola" imprime el codigo en el log y lo devuelve en la respuesta (solo desarrollo).
CORREO_MODO=consola
