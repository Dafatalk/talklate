# Puerto del API
PORT=3000
# Secreto para firmar los tokens (obligatorio en produccion)
JWT_SECRET=cambia-este-secreto
# Vida del token de acceso (segundos) y del token de refresco (dias)
# DURACION_ACCESO_SEG=900
# DURACION_REFRESCO_DIAS=30
# Clave para cifrar los mensajes guardados (obligatoria en produccion)
TALKLATE_CLAVE_CIFRADO=cambia-esta-clave
# Origenes web permitidos (CORS), separados por coma. Las apps nativas no los necesitan.
CORS_ORIGENES=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
# Mensajes por minuto por usuario (limite sobre la traduccion)
# LIMITE_MENSAJES_POR_MINUTO=30
# Base de datos: "surreal" (fuente de verdad, SurrealDB 3.x) o "sqlite" (pruebas sin servidor)
DB_DRIVER=surreal
SURREAL_URL=http://127.0.0.1:8000
SURREAL_NS=talklate
SURREAL_DB=app
# Obligatorias en produccion (no se acepta root/root)
SURREAL_USER=root
SURREAL_PASS=root
# SURREAL_TIMEOUT_MS=15000
# Ruta de la base SQLite cuando DB_DRIVER=sqlite (por defecto data/talklate.db)
# TALKLATE_DB=./data/talklate.db
# Administrador inicial (se crea al arrancar si no existe)
ADMIN_CORREO=dafa123.daf@gmail.com
ADMIN_PASSWORD=Admin123!
# Motor de traduccion. "auto" prueba en orden: Qwen local (Ollama) -> Claude Sonnet (si hay clave) -> motor de reglas.
# Otras opciones: qwen, claude, local (solo reglas).
TRADUCTOR=auto
# Qwen local con Ollama (https://ollama.com): ollama pull qwen2.5:7b
# OLLAMA_URL=http://localhost:11434
# QWEN_MODEL=qwen2.5:7b
# QWEN_TIMEOUT_MS=60000
# Respaldo con Claude Sonnet
# ANTHROPIC_API_KEY=
# TALKLATE_MODEL=claude-sonnet-5-5
# Recuperacion de contrasena: "consola" (solo desarrollo) devuelve el codigo en la respuesta.
CORREO_MODO=consola
