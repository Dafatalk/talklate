{
  "name": "talklate-backend",
  "version": "1.0.0",
  "description": "API de TalkLate: traduccion en tiempo real con conciencia de matices culturales",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:surreal": "TEST_DB_DRIVER=surreal node --test test/api.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=80 --test-coverage-functions=80 test/*.test.js",
    "medir": "node scripts/medir-traduccion.js",
    "medir:voz": "node --env-file-if-exists=.env scripts/medir-voz.js",
    "arch:check": "depcruise src",
    "arch:graph": "depcruise src --output-type mermaid"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.0.0"
  }
}
